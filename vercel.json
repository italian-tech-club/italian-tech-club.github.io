{
  "version": 2,
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/m/:slug/card.jpg", "destination": "/api/community/card?slug=:slug&format=jpg" },
    { "source": "/m/:slug", "destination": "/api/card/:slug" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
